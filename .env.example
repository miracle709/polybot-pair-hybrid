# Paper needs no API creds. Live needs them (derive via: node derive-creds.js).
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# Live only.
PM_PRIVATE_KEY=
PM_CLOB_HOST=https://clob.polymarket.com
# Live also requires CONFIRM_LIVE=YES_I_ACCEPT_REAL_MONEY_RISK

# Your VERIFIED fee tier in bps of notional. Required for live; paper
# defaults PAPER_FEE_BPS to 0. The strategy's gross edge is ~190 bps of
# deployed USDC — refuse above ~40 bps.
FEE_BPS=
# PAPER_FEE_BPS=0

# V2 finite pair-cycle economics. Prices are integer mils (985 = $0.985).
PAIR_TARGET_MILS=985
PAIR_EXECUTION_BUFFER_MILS=5
PAIR_HARD_MAX_MILS=995
MAX_UNMATCHED_SHARES=10
MAX_UNMATCHED_AGE_SECONDS=60
ALLOW_NEGATIVE_PAIR_LOCK=0
REPLENISH_AHEAD_LEG=0

# V2 round regimes: WARMUP -> DISCOVERY -> ACCUMULATION -> COMPLETION ->
# RISK_REDUCTION -> CLOSE_ONLY. QUOTE_STOP_SECONDS remains 300.
PAIR_DISCOVERY_START_SECONDS=20
PAIR_ACCUMULATION_START_SECONDS=90
PAIR_ACCUMULATION_END_SECONDS=210
PAIR_COMPLETION_END_SECONDS=260
PAIR_RISK_REDUCTION_END_SECONDS=285

# Rate limiter. Measure under paper (or a tiny supervised live run) before
# raising capacity — delayed cancels are expensive.
RL_CAPACITY=60
RL_REFILL=8

# Min ms between OrderManager reconciles (lower = more place/cancel churn).
# MIN_REQUOTE_INTERVAL_MS=500

# Process halt rails (not target-wallet quote logic).
MAX_DAILY_LOSS=500
MAX_OPEN_NOTIONAL=2000

# Paper virtual bankroll = deposit + lifetime settled PnL.
# PAPER_INITIAL_DEPOSIT=500

# Dynamic sizing halves aggregate leg size above this USD notional, then stops
# new exposure once filled cost plus desired resting orders reaches the hard cap.
# ROUND_SOFT_CAP=200
# ROUND_HARD_CAP=250
# MAX_TILT_SHARES=20

# Paper fill model (JSONL replay + npm run paper).
# PAPER_QUEUE_AHEAD=1
# PAPER_PLACE_LATENCY_MS=600
# PAPER_CANCEL_LATENCY_MS=600
# PAPER_TRADE_FRACTION=0.6
# POLYMARKET_TAKER_FEE_RATE=0.07

# Status dashboard (default host is loopback).
STATUS_SNAPSHOT_MS=250
STATUS_PORT=8776
STATUS_HOST=127.0.0.1
STATUS_TOKEN=

# Dynamic order-size bounds (deliberate exception vs target's ~90-share clips).
DYNAMIC_SIZING=1
MIN_RUNG_SHARES=5
MAX_RUNG_SHARES=20
MAX_LEG_SHARES=20
# Legacy compatibility alias; V2 quoting uses PAIR_DISCOVERY_START_SECONDS.
ENTRY_GATE_SECONDS=20
OPENING_MAX_RUNG_SHARES=20
# OPENING_CONSERVATIVE_UNTIL_SECONDS=30
# RUNG_DEPTH_FRACTION=0.10

# Optional price-to-beat / resolution (live/paper).
# POLYGON_RPC=
# PTB_FILE=
# PTB_URL=
# PTB_FIELD=
